    "test:xrf": "tsx test/xrf.test.ts",
    "test:wo": "tsx test/work-order.test.ts",
    "test:prep": "tsx test/preparation.test.ts",
    "test:results": "tsx test/test-result.test.ts",
    "test:qc": "tsx test/qc.test.ts",
    "test:equipment": "tsx test/equipment.test.ts",
    "test:reagent": "tsx test/reagent.test.ts",
    "test:invoice": "tsx test/invoice.test.ts",
    "test:submission": "tsx test/submission.test.ts",
    "test:all": "tsx test/master_e2e.test.ts && tsx test/sample.test.ts && tsx test/xrf.test.ts && tsx test/work-order.test.ts && tsx test/preparation.test.ts && tsx test/test-result.test.ts && tsx test/qc.test.ts && tsx test/equipment.test.ts && tsx test/reagent.test.ts && tsx test/invoice.test.ts && tsx test/submission.test.ts",
